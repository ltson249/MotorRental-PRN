@model List<MotorbikeVm>
@{
    ViewData["Title"] = "Quản lý xe máy";
    string? status = ViewBag.Status;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1 text-primary"><i class="bi bi-bicycle"></i> Danh sách xe máy</h3>
        <span class="text-muted small">Quản lý đội xe, theo dõi trạng thái và giá thuê</span>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> + Thêm xe mới
        </a>
    }
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card shadow-sm border-0 mb-3 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm theo tên xe, biển số, hãng..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Available" selected="@(status == "Available")">Sẵn sàng</option>
                    <option value="Rented" selected="@(status == "Rented")">Đang cho thuê</option>
                    <option value="Maintenance" selected="@(status == "Maintenance")">Bảo trì</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-outline-primary w-100">Tìm kiếm</button>
            </div>
        </form>
    </div>
</div>

<!-- Bảng xe máy -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary">
                <tr>
                    <th>Biển kiểm soát</th>
                    <th>Tên xe</th>
                    <th>Hãng</th>
                    <th>Dung tích</th>
                    <th>Giá thuê/ngày</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width: 200px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><span class="badge text-bg-dark font-monospace fs-6">@m.LicensePlate</span></td>
                        <td class="fw-semibold">@m.Name</td>
                        <td><span class="badge text-bg-light border">@m.Brand</span></td>
                        <td>@m.EngineCapacity cc</td>
                        <td class="fw-bold text-primary"><money value="@m.PricePerDay" /></td>
                        <td><status-badge status="@m.Status" /></td>
                        <td class="text-end text-nowrap">
                            @if (m.Status == "Available")
                            {
                                <a class="btn btn-sm btn-success me-1" asp-controller="Rentals" asp-action="Create" asp-route-bikeId="@m.MotorbikeId" title="Lập hợp đồng cho thuê xe này">
                                    <i class="bi bi-key-fill"></i> Cho thuê
                                </a>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@m.MotorbikeId" title="Sửa thông tin">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@m.MotorbikeId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa xe @m.LicensePlate?');">
                                    <button class="btn btn-sm btn-outline-danger" title="Xóa xe">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i> Không tìm thấy xe máy nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>