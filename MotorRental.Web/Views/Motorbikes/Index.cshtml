@model List<MotorbikeVm>
@{
    ViewData["Title"] = "Quản lý Đội xe máy";
    string? status = ViewBag.Status;
    string? category = ViewBag.Category;
    string? q = ViewBag.Q;
    string viewMode = ViewBag.ViewMode ?? "grid";

    var countTotal = Model.Count;
    var countAvailable = Model.Count(x => x.Status == "Available");
    var countRented = Model.Count(x => x.Status == "Rented");
    var countMaint = Model.Count(x => x.Status == "Maintenance");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-bicycle text-primary me-2"></i>Đội Xe Máy</h2>
        <p class="text-muted mb-0 small">Quản lý danh sách phương tiện, giá thuê, định mức bảo dưỡng và hình ảnh xe</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" asp-action="Create">
            <i class="bi bi-plus-circle"></i> + Nhập phương tiện mới
        </a>
    }
</div>

<!-- Bộ lọc tìm kiếm & View Mode Toggle -->
<div class="card card-custom mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <input type="hidden" name="viewMode" value="@viewMode" id="inpViewMode" />
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input name="q" value="@q" class="form-control border-start-0" placeholder="Tìm theo tên xe, biển số, hãng..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Available" selected="@(status == "Available")">Sẵn sàng phục vụ</option>
                <option value="Rented" selected="@(status == "Rented")">Đang cho thuê</option>
                <option value="Maintenance" selected="@(status == "Maintenance")">Đang bảo trì/sửa</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select name="category" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả phân loại --</option>
                <option value="Xe số" selected="@(category == "Xe số")">Xe số (Manual)</option>
                <option value="Xe tay ga" selected="@(category == "Xe tay ga")">Xe tay ga (Scooter)</option>
                <option value="Xe côn tay" selected="@(category == "Xe côn tay")">Xe côn tay (Clutch)</option>
                <option value="Xe điện" selected="@(category == "Xe điện")">Xe máy điện (EV)</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Lọc</button>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-secondary @(viewMode == "grid" ? "active" : "")" 
                        onclick="document.getElementById('inpViewMode').value='grid'; this.form.submit();" title="Xem dạng lưới ảnh">
                    <i class="bi bi-grid-fill"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary @(viewMode == "table" ? "active" : "")" 
                        onclick="document.getElementById('inpViewMode').value='table'; this.form.submit();" title="Xem dạng bảng danh sách">
                    <i class="bi bi-list-ul"></i>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ======================= 1. DẠNG LƯỚI THẺ ẢNH (CARD GRID) ======================= -->
@if (viewMode == "grid")
{
    <div class="row g-3">
        @foreach (var m in Model)
        {
            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="bike-card">
                    <div class="bike-img-wrap">
                        <span class="bike-plate-badge">@m.LicensePlate</span>
                        <span class="bike-status-badge"><status-badge status="@m.Status" /></span>
                        @if (!string.IsNullOrEmpty(m.ImageUrl))
                        {
                            <img src="@m.ImageUrl" alt="@m.Name" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=500&auto=format&fit=crop&q=60'" />
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                <i class="bi bi-bicycle fs-1 mb-1"></i>
                                <span class="small" style="font-size: 0.75rem;">Chưa có ảnh</span>
                            </div>
                        }
                    </div>

                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 class="fw-bold mb-0 text-truncate" title="@m.Name">@m.Name</h6>
                            <category-badge category="@m.Category" />
                        </div>
                        <div class="small text-muted mb-2">
                            <span><i class="bi bi-tag"></i> @m.Brand</span> &bull; 
                            <span>@m.EngineCapacity cc</span>
                            @if (!string.IsNullOrEmpty(m.Color))
                            {
                                <span> &bull; Màu: @m.Color</span>
                            }
                        </div>
                        <div class="small text-secondary mb-3">
                            <i class="bi bi-speedometer2"></i> Đồng hồ ODO: <strong>@(m.CurrentOdometer > 0 ? $"{m.CurrentOdometer:N0} km" : "Chưa cập nhật")</strong>
                        </div>

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.72rem;">GIÁ THUÊ/NGÀY</span>
                                <span class="fw-bold text-primary fs-6"><money value="@m.PricePerDay" /></span>
                            </div>

                            <div class="d-flex gap-1">
                                @if (m.Status == "Available")
                                {
                                    <a class="btn btn-sm btn-success px-2" asp-controller="Rentals" asp-action="Create" asp-route-bikeId="@m.MotorbikeId" title="Cho thuê xe này">
                                        <i class="bi bi-key-fill"></i> Thuê
                                    </a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="btn btn-sm btn-outline-secondary px-2" asp-action="Edit" asp-route-id="@m.MotorbikeId" title="Chỉnh sửa thông tin">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@m.MotorbikeId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa xe @m.LicensePlate?');">
                                        <button class="btn btn-sm btn-outline-danger px-2" title="Xóa phương tiện">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card card-custom p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    <h5>Không tìm thấy phương tiện nào phù hợp với bộ lọc.</h5>
                    <p class="small text-muted mb-3">Hãy thử thay đổi từ khóa hoặc điều kiện lọc trạng thái xe.</p>
                    <div><a class="btn btn-sm btn-outline-secondary" asp-action="Index">Đặt lại bộ lọc</a></div>
                </div>
            </div>
        }
    </div>
}
<!-- ======================= 2. DẠNG BẢNG DANH SÁCH (TABLE LIST) ======================= -->
else
{
    <div class="card card-custom">
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width: 80px;">Hình ảnh</th>
                        <th>Biển số</th>
                        <th>Tên phương tiện</th>
                        <th>Phân loại</th>
                        <th>Dung tích</th>
                        <th>Đồng hồ ODO</th>
                        <th>Giá thuê / ngày</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>
                                <div style="width: 60px; height: 42px; border-radius: 6px; overflow: hidden; background: #e2e8f0;">
                                    @if (!string.IsNullOrEmpty(m.ImageUrl))
                                    {
                                        <img src="@m.ImageUrl" alt="@m.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=500&auto=format&fit=crop&q=60'" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-bicycle"></i></div>
                                    }
                                </div>
                            </td>
                            <td><span class="badge bg-dark font-monospace fs-6">@m.LicensePlate</span></td>
                            <td>
                                <div class="fw-semibold">@m.Name</div>
                                <small class="text-muted">Hãng: @m.Brand @(!string.IsNullOrEmpty(m.Color) ? $"&bull; Màu {m.Color}" : "")</small>
                            </td>
                            <td><category-badge category="@m.Category" /></td>
                            <td>@m.EngineCapacity cc</td>
                            <td>@(m.CurrentOdometer > 0 ? $"{m.CurrentOdometer:N0} km" : "---")</td>
                            <td class="fw-bold text-primary"><money value="@m.PricePerDay" /></td>
                            <td><status-badge status="@m.Status" /></td>
                            <td class="text-end text-nowrap">
                                @if (m.Status == "Available")
                                {
                                    <a class="btn btn-sm btn-success me-1" asp-controller="Rentals" asp-action="Create" asp-route-bikeId="@m.MotorbikeId" title="Cho thuê xe này">
                                        <i class="bi bi-key-fill"></i> Thuê
                                    </a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@m.MotorbikeId" title="Sửa thông tin">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@m.MotorbikeId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa xe @m.LicensePlate?');">
                                        <button class="btn btn-sm btn-outline-danger" title="Xóa phương tiện">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i> Không tìm thấy phương tiện nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
