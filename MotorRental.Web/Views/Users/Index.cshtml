@model List<UserVm>
@{
    ViewData["Title"] = "Quản lý Tài khoản & Phân quyền";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-shield-lock text-primary me-2"></i>Tài Khoản & Phân Quyền</h2>
        <p class="text-muted mb-0 small">Quản lý nhân viên, phân quyền vai trò Admin/Staff và trạng thái hoạt động tài khoản</p>
    </div>
    <a class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" asp-action="Create">
        <i class="bi bi-person-plus"></i> + Thêm tài khoản mới
    </a>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th style="width: 60px;">Mã</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ và tên</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">#@u.UserId</td>
                        <td class="fw-bold font-monospace text-primary">@u.Username</td>
                        <td class="fw-semibold">@u.FullName</td>
                        <td><status-badge status="@u.Role" /></td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-check-circle-fill me-1"></i>Đang hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                    <i class="bi bi-lock-fill me-1"></i>Đã khóa
                                </span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <form asp-action="Toggle" asp-route-id="@u.UserId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn @(u.IsActive ? "khóa" : "kích hoạt lại") tài khoản @u.Username?');">
                                <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock")"></i> @(u.IsActive ? "Khóa" : "Mở khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
