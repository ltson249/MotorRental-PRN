@model ResetPasswordVm
@{
    ViewData["Title"] = "Đặt lại mật khẩu - MotorRental FPT Hòa Lạc";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 shadow">
            <div class="text-center mb-4">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 56px; height: 56px;">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </div>
                <h4 class="fw-bold mb-1 text-dark">Đặt Lại <span class="text-primary">Mật Khẩu</span></h4>
                <p class="text-muted small">Nhập mã OTP vừa nhận qua email và mật khẩu mới</p>
            </div>

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info py-2 small shadow-sm">
                    <i class="bi bi-info-circle-fill me-1"></i> @TempData["InfoMessage"]
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <form asp-action="ResetPassword" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control bg-light" readonly />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Otp" class="form-label fw-semibold small text-muted mb-0"></label>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle small" id="timerBadge">
                            <i class="bi bi-stopwatch me-1"></i>Hiệu lực: <span id="timerText">10:00</span>
                        </span>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-primary"><i class="bi bi-shield-check"></i></span>
                        <input asp-for="Otp" class="form-control text-center fw-bold fs-5 text-primary" placeholder="6 chữ số OTP" maxlength="10" autofocus style="letter-spacing: 4px;" />
                    </div>
                    <span asp-validation-for="Otp" class="text-danger small"></span>
                    <div class="form-text text-muted" style="font-size: 0.75rem;">
                        Kiểm tra hòm thư Email (hoặc Server Terminal API nếu đang chạy môi trường test).
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold small text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fs-6 mb-3 shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> Cập Nhật Mật Khẩu Mới
                </button>

                <div class="d-flex justify-content-between text-muted small">
                    <a asp-action="ForgotPassword" class="text-decoration-none text-muted">
                        <i class="bi bi-arrow-repeat me-1"></i>Gửi lại mã OTP
                    </a>
                    <a asp-action="Login" class="text-decoration-none text-muted">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Đếm ngược 10 phút thời gian hiệu lực OTP
        let timeLeft = 600;
        const timerText = document.getElementById('timerText');
        if (timerText) {
            const timer = setInterval(() => {
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    timerText.innerText = "Hết hạn!";
                    const badge = document.getElementById('timerBadge');
                    if (badge) badge.className = "badge bg-secondary text-white";
                } else {
                    timeLeft--;
                    const m = Math.floor(timeLeft / 60).toString().padStart(2, '0');
                    const s = (timeLeft % 60).toString().padStart(2, '0');
                    timerText.innerText = `${m}:${s}`;
                }
            }, 1000);
        }
    </script>
}
