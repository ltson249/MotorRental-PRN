@model ForgotPasswordVm
@{
    ViewData["Title"] = "Quên mật khẩu - MotorRental FPT Hòa Lạc";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow">
            <div class="text-center mb-4">
                <div class="rounded-circle bg-warning text-dark d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 56px; height: 56px;">
                    <i class="bi bi-key-fill fs-2 text-warning-emphasis"></i>
                </div>
                <h4 class="fw-bold mb-1 text-dark">Khôi Phục <span class="text-primary">Mật Khẩu</span></h4>
                <p class="text-muted small">Nhập địa chỉ email đã đăng ký để nhận mã xác thực OTP</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="alert alert-primary bg-primary bg-opacity-10 border-primary border-opacity-25 py-2 small text-primary mb-3">
                <i class="bi bi-info-circle-fill me-1"></i>
                Hệ thống sẽ gửi mã OTP gồm 6 chữ số có hiệu lực trong 10 phút đến hòm thư của bạn.
            </div>

            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope-at-fill"></i></span>
                        <input asp-for="Email" type="email" class="form-control" placeholder="vd: anhvdhe173456@fpt.edu.vn" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                    <div class="form-text text-muted" style="font-size: 0.75rem;">
                        (Có thể thử với email mẫu: <code>admin@motorrental.vn</code> hoặc <code>anhvdhe173456@fpt.edu.vn</code>)
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fs-6 mb-3 shadow-sm">
                    <i class="bi bi-send-fill me-1"></i> Gửi Mã OTP Qua Email
                </button>

                <div class="text-center">
                    <a asp-action="Login" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại trang Đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
