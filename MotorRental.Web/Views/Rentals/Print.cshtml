@model RentalDetailVm
@{
    Layout = null;
    var qrUrl = $"https://img.vietqr.io/image/VCB-1014306428-compact2.png?amount={(long)Model.TotalPrice}&addInfo=ThueXe_{Model.RentalId}_{Model.LicensePlate.Replace("-", "").Replace(" ", "").Replace(".", "")}&accountName=LE%20TIEN%20SON";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hợp đồng thuê xe #@Model.RentalId - @Model.CustomerName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif; 
            background: #f1f5f9; 
            color: #1e293b; 
        }
        .receipt-card { 
            max-width: 860px; 
            margin: 30px auto; 
            padding: 40px 48px; 
            background: #fff; 
            border: 1px solid #cbd5e1; 
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);
        }
        .contract-header {
            border-bottom: 2px solid #0f172a;
            padding-bottom: 18px;
            margin-bottom: 24px;
        }
        .table-contract th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .qr-box {
            border: 1px dashed #94a3b8;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            background: #f8fafc;
        }
    </style>

    <style media="print">
        body { background: #fff !important; }
        .no-print { display: none !important; }
        .receipt-card { 
            border: none !important; 
            padding: 0 !important; 
            margin: 0 !important; 
            max-width: 100% !important;
            box-shadow: none !important;
        }
    </style>
</head>
<body>
    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary px-4 me-2 shadow-sm">
            <i class="bi bi-printer"></i> In Hợp Đồng / Lưu Bản PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary px-3">Đóng cửa sổ</button>
    </div>

    <div class="receipt-card">
        <!-- Header -->
        <div class="row align-items-center contract-header">
            <div class="col-8">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="p-2 rounded bg-dark text-white fw-bold"><i class="bi bi-bicycle"></i></span>
                    <h4 class="fw-bold text-dark m-0">MOTORRENTAL FPT HÒA LẠC</h4>
                </div>
                <div class="small text-muted">Địa chỉ: Km29 Đại lộ Thăng Long, Thạch Hòa, Huyện Thạch Thất, TP. Hà Nội (Đối diện Cổng 1 ĐH FPT)</div>
                <div class="small text-muted">Hotline CSKH / Cứu hộ 24/7: <strong>0988 232 392</strong> &bull; Hỗ trợ sinh viên Hola Park</div>
            </div>
            <div class="col-4 text-end">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 mb-1">HỢP ĐỒNG CHO THUÊ</span>
                <h5 class="fw-bold mb-0 text-primary">#HĐ-@Model.RentalId.ToString("D5")</h5>
                <div class="text-muted small">Thời điểm lập: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="text-center my-3">
            <h5 class="fw-bold text-uppercase mb-0 tracking-wide">HỢP ĐỒNG CHO THUÊ VÀ BÀN GIAO PHƯƠNG TIỆN XE MÁY</h5>
            <small class="text-muted fst-italic">(Căn cứ theo Thỏa thuận dịch vụ phương tiện & Cam kết an toàn giao thông đường bộ)</small>
        </div>

        <!-- 2 Bên giao kết -->
        <div class="row g-3 mb-4 mt-2">
            <!-- Bên A -->
            <div class="col-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <h6 class="fw-bold text-dark mb-2 border-bottom pb-1"><i class="bi bi-building"></i> BÊN CHO THUÊ (BÊN A)</h6>
                    <div class="small mb-1">Đơn vị: <strong>Cửa hàng MotorRental FPT Hòa Lạc</strong></div>
                    <div class="small mb-1">Đại diện showroom: <strong>@Model.StaffName</strong></div>
                    <div class="small mb-1">Điện thoại hotline: <strong>0988 232 392</strong></div>
                    <div class="small">Địa điểm bàn giao: Trụ sở Km29 ĐL Thăng Long, Thạch Thất, Hà Nội</div>
                </div>
            </div>

            <!-- Bên B -->
            <div class="col-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <h6 class="fw-bold text-dark mb-2 border-bottom pb-1"><i class="bi bi-person-fill"></i> BÊN THUÊ XE (BÊN B)</h6>
                    <div class="small mb-1">Họ và tên: <strong>@Model.CustomerName</strong></div>
                    <div class="small mb-1">Số điện thoại: <strong>@Model.CustomerPhone</strong></div>
                    <div class="small mb-1">CCCD / Hộ chiếu: <strong>@Model.IdentityNumber</strong></div>
                    <div class="small mb-1">GPLX hạng: @(string.IsNullOrWhiteSpace(Model.DriverLicense) ? "Ghi nhận hợp lệ" : Model.DriverLicense)</div>
                    <div class="small text-truncate" title="@Model.CustomerAddress">Địa chỉ/KTX: @(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "Chưa ghi nhận" : Model.CustomerAddress)</div>
                </div>
            </div>
        </div>

        <!-- Thông tin xe & Lịch trình -->
        <div class="mb-4">
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check"></i> THÔNG TIN PHƯƠNG TIỆN & CHI PHÍ THUÊ</h6>
            <table class="table table-bordered table-contract align-middle text-center mb-0">
                <thead>
                    <tr>
                        <th>Phương tiện bàn giao</th>
                        <th>Biển kiểm soát</th>
                        <th>Số ODO giao xe</th>
                        <th>Thời gian thuê</th>
                        <th>Thời hạn trả xe</th>
                        <th>Đơn giá / ngày</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-start">@Model.MotorbikeName</td>
                        <td><span class="badge bg-dark font-monospace fs-6">@Model.LicensePlate</span></td>
                        <td><strong>@(Model.OdometerOut.HasValue ? Model.OdometerOut.Value.ToString("N0") + " km" : "Nguyên bản")</strong></td>
                        <td>@Model.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-bold text-danger">@Model.EndDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-bold text-primary">@Model.PricePerDay.ToString("N0") ₫</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Bảng thanh toán & Mã QR Vietcombank -->
        <div class="row align-items-center mb-4 g-3">
            <div class="col-7">
                <div class="p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tiền cọc đảm bảo hợp đồng:</span>
                        <strong class="text-success fs-6">@Model.Deposit.ToString("N0") ₫</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính tiền thuê xe:</span>
                        <strong class="text-primary fs-6">@Model.TotalPrice.ToString("N0") ₫</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Trạng thái thanh toán:</span>
                        <span class="badge bg-primary text-white">@(Model.PaymentStatus == "FullyPaid" ? "Đã thanh toán đủ" : (Model.PaymentStatus == "DepositPaid" ? "Đã đặt cọc VietQR" : "Chưa thanh toán"))</span>
                    </div>
                    @if (Model.ReturnDate.HasValue)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-danger">
                            <span>Phụ phí phát sinh (trễ hạn/hư hại/xăng):</span>
                            <strong>@((Model.LateFee + Model.DamageFee + Model.OtherFee).ToString("N0")) ₫</strong>
                        </div>
                        <div class="d-flex justify-content-between pt-2 border-top">
                            <span class="fw-bold">Khách thực trả / Cửa hàng hoàn cọc:</span>
                            <span class="fw-bold text-dark fs-5">@Model.ActualPayment.ToString("N0") ₫</span>
                        </div>
                    }
                    <div class="small text-muted mt-2 border-top pt-2">
                        <strong>Biên bản phụ kiện bàn giao:</strong> @(string.IsNullOrWhiteSpace(Model.Note) ? "02 Mũ bảo hiểm Hola, 01 Áo mưa, gương chiếu hậu và giấy tờ xe photo công chứng." : Model.Note)
                    </div>
                </div>
            </div>

            <!-- VietQR Box chuẩn Vietcombank LE TIEN SON 1014306428 -->
            <div class="col-5">
                <div class="qr-box">
                    <div class="small fw-bold text-success text-uppercase mb-1">
                        <i class="bi bi-qr-code-scan"></i> Vietcombank Napas 247
                    </div>
                    <img src="@qrUrl" alt="VietQR Vietcombank LE TIEN SON" style="width: 140px; height: 140px; object-fit: contain;" />
                    <div class="fw-bold text-dark small mt-1">LE TIEN SON</div>
                    <div class="small text-primary font-monospace" style="font-size: 0.75rem;">STK: 1014306428</div>
                    <div class="small text-muted" style="font-size: 0.68rem;">Vietcombank - Trụ sở CN Quảng Ninh</div>
                </div>
            </div>
        </div>

        <!-- Điều khoản -->
        <div class="small text-muted p-3 bg-light rounded-3 border mb-4" style="font-size: 0.78rem; line-height: 1.45;">
            <strong>ĐIỀU KHOẢN VÀ TRÁCH NHIỆM BÊN THUÊ XE:</strong>
            <ul class="mb-0 ps-3 mt-1">
                <li>Bên B cam kết tuân thủ nghiêm chỉnh Luật Giao thông đường bộ, đội mũ bảo hiểm khi lưu thông, chịu hoàn toàn trách nhiệm về vi phạm giao thông và phạt nguội.</li>
                <li>Không sử dụng xe vào mục đích cầm cố, thế chấp, cho bên thứ ba thuê lại, đua xe trái phép.</li>
                <li>Mọi trường hợp hư hại do va chạm, trầy xước, thiếu đồ đạc hoặc trễ hạn bàn giao xe so với giờ ghi trong hợp đồng sẽ tính theo biểu phí nghiệm thu của showroom.</li>
            </ul>
        </div>

        <!-- Chữ ký 2 bên -->
        <div class="row pt-2 text-center">
            <div class="col-6">
                <strong class="text-uppercase text-dark d-block">ĐẠI DIỆN BÊN THUÊ (BÊN B)</strong>
                <span class="small text-muted">(Ký, ghi rõ họ tên và nhận bàn giao xe)</span>
                <div style="height: 75px;"></div>
                <div class="fw-bold fs-6">@Model.CustomerName</div>
            </div>
            <div class="col-6">
                <strong class="text-uppercase text-dark d-block">ĐẠI DIỆN SHOWROOM HÒA LẠC (BÊN A)</strong>
                <span class="small text-muted">(Ký, đóng dấu xác nhận bàn giao)</span>
                <div style="height: 75px;"></div>
                <div class="fw-bold fs-6">@Model.StaffName</div>
            </div>
        </div>
    </div>
</body>
</html>
