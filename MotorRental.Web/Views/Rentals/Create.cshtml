@model CreateRentalVm
@{
    bool isCustomer = User.IsInRole("Customer");
    ViewData["Title"] = isCustomer ? "Đăng ký thuê xe máy trực tuyến" : "Lập phiếu thuê xe máy";
    var customers = ViewBag.Customers as List<CustomerVm> ?? new();
    var bikes = ViewBag.Bikes as List<MotorbikeVm> ?? new();
    var myCustomer = ViewBag.MyCustomer as CustomerVm;
}

<div class="mb-4">
    <a class="btn btn-sm btn-outline-secondary mb-2" asp-action="@(isCustomer ? "MyRentals" : "Index")">
        <i class="bi bi-arrow-left"></i> Quay lại @(isCustomer ? "xe tôi đang thuê" : "danh sách")
    </a>
    <h2 class="fw-bold mb-1 text-dark">
        <i class="bi @(isCustomer ? "bi-calendar-check-fill" : "bi-file-earmark-plus") text-primary me-2"></i>
        @(isCustomer ? "Đăng Ký Thuê Xe Máy Trực Tuyến" : "Lập Hợp Đồng Thuê Xe Máy")
    </h2>
    <p class="text-muted small">
        @(isCustomer 
            ? "Cổng dịch vụ thuê xe máy dành riêng cho Sinh viên, Giảng viên ĐH FPT và Cư dân Hòa Lạc" 
            : "Kiểm tra thông tin khách hàng, tình trạng xe và biên bản phụ kiện trước khi bàn giao")
    </p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card card-custom p-4 shadow-sm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <form asp-action="Create" method="post" id="rentalForm">
                <!-- 1. THÔNG TIN KHÁCH HÀNG -->
                <div class="mb-4 pb-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-3"><span class="badge bg-primary me-1">1</span> Thông tin Khách hàng</h5>

                    @if (isCustomer)
                    {
                        <input type="hidden" asp-for="CustomerId" />
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <span class="text-muted small d-block">Họ và tên người thuê:</span>
                                    <strong class="text-dark fs-6">@(myCustomer?.FullName ?? User.FindFirst("FullName")?.Value ?? "Sinh viên FPT")</strong>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted small d-block">Số điện thoại liên hệ:</span>
                                    <strong class="text-dark"><i class="bi bi-telephone text-primary me-1"></i>@(myCustomer?.Phone ?? "Chưa cập nhật")</strong>
                                </div>
                                <div class="col-sm-6 mt-2">
                                    <span class="text-muted small d-block">Số CCCD / CMND:</span>
                                    <span class="font-monospace">@(myCustomer?.IdentityNumber ?? "Chưa cập nhật")</span>
                                </div>
                                <div class="col-sm-6 mt-2">
                                    <span class="text-muted small d-block">Địa chỉ nhận xe (KTX / Khu vực):</span>
                                    <span><i class="bi bi-geo-alt text-danger me-1"></i>@(myCustomer?.Address ?? "Đại học FPT Hòa Lạc")</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-md-9">
                                <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                                <select asp-for="CustomerId" class="form-select" id="selCustomer">
                                    <option value="0">-- Chọn khách hàng đã có trong hệ thống --</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.CustomerId" data-phone="@c.Phone" data-cccd="@c.IdentityNumber">
                                            @c.FullName &mdash; SĐT: @c.Phone &mdash; CCCD: @c.IdentityNumber
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <a class="btn btn-outline-primary w-100" asp-controller="Customers" asp-action="Create" target="_blank">
                                    <i class="bi bi-person-plus"></i> + Thêm khách
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <!-- 2. CHỌN PHƯƠNG TIỆN -->
                <div class="mb-4 pb-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-3"><span class="badge bg-primary me-1">2</span> Phương tiện Bàn giao</h5>
                    <div class="row g-3">
                        <div class="@(isCustomer ? "col-12" : "col-md-8")">
                            <label asp-for="MotorbikeId" class="form-label fw-semibold">Xe máy lựa chọn</label>
                            <select asp-for="MotorbikeId" class="form-select" id="selBike">
                                <option value="0">-- Chọn dòng xe bạn muốn thuê --</option>
                                @foreach (var b in bikes)
                                {
                                    <option value="@b.MotorbikeId" 
                                            data-price="@b.PricePerDay" 
                                            data-odo="@b.CurrentOdometer"
                                            data-plate="@b.LicensePlate"
                                            data-name="@b.Name"
                                            selected="@(Model.MotorbikeId == b.MotorbikeId)">
                                        [@b.LicensePlate] @b.Name (@b.Category - @b.EngineCapacity cc) - @b.PricePerDay.ToString("N0") ₫/ngày
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="MotorbikeId" class="text-danger small"></span>
                        </div>

                        @if (!isCustomer)
                        {
                            <div class="col-md-4">
                                <label asp-for="OdometerOut" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="OdometerOut" id="inpOdoOut" class="form-control" placeholder="12500" />
                                    <span class="input-group-text">km</span>
                                </div>
                                <span class="small text-muted" style="font-size: 0.72rem;">Số km trên đồng hồ lúc giao</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- 3. LỊCH TRÌNH & ĐẶT CỌC -->
                <div class="mb-4 pb-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-3"><span class="badge bg-primary me-1">3</span> Lịch Trình & Đặt Cọc</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label fw-semibold">Thời điểm nhận xe</label>
                            <input asp-for="StartDate" type="datetime-local" class="form-control" id="inpStartDate" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndDate" class="form-label fw-semibold">Thời điểm trả xe dự kiến</label>
                            <input asp-for="EndDate" type="datetime-local" class="form-control" id="inpEndDate" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Deposit" class="form-label fw-semibold">Tiền cọc giữ xe</label>
                            <div class="input-group">
                                <input asp-for="Deposit" class="form-control" id="inpDeposit" value="@(isCustomer && Model.Deposit == 0 ? 500000 : Model.Deposit)" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="Deposit" class="text-danger small"></span>
                            <span class="small text-muted" style="font-size: 0.72rem;">Cọc sẽ được hoàn lại 100% khi trả xe</span>
                        </div>
                    </div>
                </div>

                <!-- 4. GHI CHÚ GIAO NHẬN -->
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-3"><span class="badge bg-primary me-1">4</span> Yêu Cầu & Ghi Chú Giao Nhận</h5>
                    
                    @if (!isCustomer)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input accessory-chk" type="checkbox" value="02 Mũ bảo hiểm" id="chkHelmet" checked>
                                    <label class="form-check-label small" for="chkHelmet">02 Mũ bảo hiểm</label>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input accessory-chk" type="checkbox" value="01 Áo mưa" id="chkRaincoat" checked>
                                    <label class="form-check-label small" for="chkRaincoat">01 Áo mưa</label>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input accessory-chk" type="checkbox" value="Cavet xe công chứng" id="chkCavet" checked>
                                    <label class="form-check-label small" for="chkCavet">Cavet photo CC</label>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input accessory-chk" type="checkbox" value="Giá đỡ điện thoại" id="chkHolder">
                                    <label class="form-check-label small" for="chkHolder">Giá đỡ ĐT</label>
                                </div>
                            </div>
                        </div>
                    }

                    <label asp-for="Note" class="form-label fw-semibold">
                        @(isCustomer ? "Ghi chú nơi giao xe (KTX Dom A/B/C, Cổng trường, Sảnh Alpha...)" : "Ghi chú hợp đồng")
                    </label>
                    <textarea asp-for="Note" id="txtNote" class="form-control" rows="2" placeholder="@(isCustomer ? "Ví dụ: Giao xe lúc 8h sáng tại sảnh KTX Dom A ĐH FPT Hà Nội..." : "")"></textarea>
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 fs-6 shadow-sm">
                        <i class="bi @(isCustomer ? "bi-check2-circle" : "bi-file-earmark-check")"></i>
                        @(isCustomer ? "Xác Nhận Đặt Thuê Xe & Giữ Chỗ" : "Xác nhận & Xuất hợp đồng")
                    </button>
                    <a class="btn btn-outline-secondary px-3" asp-action="@(isCustomer ? "MyRentals" : "Index")">Hủy</a>
                </div>
            </form>
        </div>
    </div>

    <!-- TẠM TÍNH HỢP ĐỒNG & VIETQR THANH TOÁN -->
    <div class="col-lg-4">
        <div class="card card-custom p-4 sticky-top shadow-sm" style="top: 80px;">
            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-receipt text-primary me-1"></i> Tạm Tính Chi Phí</h5>
            <div class="p-3 bg-light rounded-3 mb-3 border">
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Đơn giá thuê:</span>
                    <strong id="prevDailyPrice" class="text-dark">0 ₫ / ngày</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Số ngày thuê:</span>
                    <strong id="prevDays" class="text-dark">1 ngày</strong>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Tiền cọc giữ xe:</span>
                    <strong id="prevDeposit" class="text-success">0 ₫</strong>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Tổng tiền thuê:</span>
                    <span class="fs-4 fw-bold text-primary" id="prevTotal">0 ₫</span>
                </div>
            </div>

            <!-- Box VietQR chuyển khoản cọc -->
            <div class="card border-primary border-opacity-25 bg-primary bg-opacity-10 p-3 text-center mb-3">
                <div class="small fw-bold text-primary text-uppercase mb-1"><i class="bi bi-qr-code-scan me-1"></i>Quét VietQR Đặt Cọc Trực Tuyến</div>
                <p class="text-muted mb-2" style="font-size: 0.72rem;">Chuyển cọc giữ xe qua tài khoản chính thức Showroom FPT Hòa Lạc</p>
                <div class="bg-white p-2 rounded border d-inline-block mx-auto mb-2 shadow-sm">
                    <img id="vietQrImg" src="https://img.vietqr.io/image/VCB-1014306428-compact2.png?amount=500000&addInfo=DATCOC_THUEXE&accountName=LE%20TIEN%20SON" alt="VietQR Vietcombank" style="max-width: 170px; height: auto;" />
                </div>
                <div class="small text-dark fw-bold">LE TIEN SON</div>
                <div class="font-monospace text-primary fw-bold" style="font-size: 0.95rem;">1014306428 &bull; Vietcombank</div>
            </div>

            <div class="alert alert-info py-2 px-3 small border-0 m-0">
                <i class="bi bi-info-circle-fill me-1"></i>
                @(isCustomer 
                    ? "Sau khi đặt xe, bạn có thể kiểm tra phiếu thuê trong mục 'Xe tôi đang thuê' và in hợp đồng bàn giao kèm mã QR."
                    : "Sau khi tạo phiếu, bạn có thể lập tức in bản hợp đồng bàn giao có mã QR thanh toán và chữ ký 2 bên.")
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selBike = document.getElementById('selBike');
            const inpStartDate = document.getElementById('inpStartDate');
            const inpEndDate = document.getElementById('inpEndDate');
            const inpDeposit = document.getElementById('inpDeposit');
            const inpOdoOut = document.getElementById('inpOdoOut');

            const prevDaily = document.getElementById('prevDailyPrice');
            const prevDays = document.getElementById('prevDays');
            const prevDeposit = document.getElementById('prevDeposit');
            const prevTotal = document.getElementById('prevTotal');
            const vietQrImg = document.getElementById('vietQrImg');

            function updateCalc() {
                const opt = selBike.options[selBike.selectedIndex];
                const price = parseFloat(opt.getAttribute('data-price')) || 0;
                const plate = opt.getAttribute('data-plate') || 'XE';
                const odo = opt.getAttribute('data-odo');
                if (odo && inpOdoOut && !inpOdoOut.value) {
                    inpOdoOut.value = odo;
                }

                const s = new Date(inpStartDate.value);
                const e = new Date(inpEndDate.value);
                let days = 1;
                if (!isNaN(s) && !isNaN(e) && e > s) {
                    const diffTime = Math.abs(e - s);
                    days = Math.max(Math.ceil(diffTime / (1000 * 60 * 60 * 24)), 1);
                }

                const total = price * days;
                const dep = parseFloat(inpDeposit.value) || 0;

                prevDaily.textContent = price.toLocaleString('vi-VN') + ' ₫ / ngày';
                prevDays.textContent = days + ' ngày';
                prevDeposit.textContent = dep.toLocaleString('vi-VN') + ' ₫';
                prevTotal.textContent = total.toLocaleString('vi-VN') + ' ₫';

                // Cập nhật mã VietQR động
                if (vietQrImg) {
                    const qrAmount = dep > 0 ? dep : (total > 0 ? total : 500000);
                    const qrInfo = encodeURIComponent('DATCOC_' + plate.replace(/[^A-Za-z0-9]/g, ''));
                    vietQrImg.src = `https://img.vietqr.io/image/VCB-1014306428-compact2.png?amount=${qrAmount}&addInfo=${qrInfo}&accountName=LE%20TIEN%20SON`;
                }
            }

            selBike.addEventListener('change', updateCalc);
            inpStartDate.addEventListener('input', updateCalc);
            inpEndDate.addEventListener('input', updateCalc);
            inpDeposit.addEventListener('input', updateCalc);

            updateCalc();

            // Checklist update note (cho admin/staff)
            const chks = document.querySelectorAll('.accessory-chk');
            const txtNote = document.getElementById('txtNote');
            if (chks.length > 0 && txtNote) {
                chks.forEach(c => {
                    c.addEventListener('change', function () {
                        const selected = Array.from(chks).filter(x => x.checked).map(x => x.value);
                        txtNote.value = 'Bàn giao: ' + selected.join(', ') + '.';
                    });
                });
            }
        });
    </script>
}
