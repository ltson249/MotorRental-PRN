@model List<RentalVm>
@{
    ViewData["Title"] = "Quản lý phiếu thuê";
    string? status = ViewBag.Status;
    string? q = ViewBag.Q;
    bool isOverdue = ViewBag.OverdueOnly == true;
    var now = DateTime.Now;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1 text-primary"><i class="bi bi-file-earmark-text"></i> Phiếu thuê xe</h3>
        <span class="text-muted small">Quản lý bàn giao xe, nhận trả xe và quyết toán cọc</span>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-circle"></i> + Tạo phiếu thuê mới
    </a>
</div>

<!-- Bộ lọc & Tìm kiếm -->
<div class="card shadow-sm border-0 mb-3 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input name="q" value="@q" class="form-control" placeholder="Tìm theo tên khách, SĐT, biển số xe..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Active" selected="@(status == "Active")">Đang thuê</option>
                    <option value="Completed" selected="@(status == "Completed")">Đã hoàn tất</option>
                    <option value="Cancelled" selected="@(status == "Cancelled")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch pt-2">
                    <input class="form-check-input" type="checkbox" name="overdueOnly" value="true" id="chkOverdue" 
                           checked="@isOverdue" onchange="this.form.submit()">
                    <label class="form-check-label text-danger fw-semibold" for="chkOverdue">
                        <i class="bi bi-exclamation-triangle-fill"></i> Chỉ xe quá hạn
                    </label>
                </div>
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-outline-primary w-100">Lọc dữ liệu</button>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách phiếu thuê -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary">
                <tr>
                    <th style="width: 60px;">Mã</th>
                    <th>Khách hàng</th>
                    <th>Phương tiện</th>
                    <th>Thời gian thuê</th>
                    <th>Thời hạn trả</th>
                    <th>Tiền cọc</th>
                    <th>Tạm tính</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width: 170px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    bool isLate = r.Status == "Active" && r.EndDate < now;
                    <tr class="@(isLate ? "table-danger-subtle border-start border-danger border-4" : "")">
                        <td class="fw-bold">#@r.RentalId</td>
                        <td>
                            <div class="fw-semibold">@r.CustomerName</div>
                            <small class="text-muted"><i class="bi bi-person"></i> NV: @r.StaffName</small>
                        </td>
                        <td>
                            <span class="badge text-bg-light border text-dark fw-bold">@r.LicensePlate</span>
                            <div class="small text-truncate" style="max-width: 180px;">@r.MotorbikeName</div>
                        </td>
                        <td>
                            <small>@r.StartDate.ToString("dd/MM/yyyy")</small><br />
                            <small class="text-muted">@r.StartDate.ToString("HH:mm")</small>
                        </td>
                        <td>
                            <small class="@(isLate ? "text-danger fw-bold" : "")">@r.EndDate.ToString("dd/MM/yyyy HH:mm")</small>
                            @if (r.ReturnDate.HasValue)
                            {
                                <div class="small text-success"><i class="bi bi-check-all"></i> Đã trả: @r.ReturnDate.Value.ToString("dd/MM HH:mm")</div>
                            }
                            else if (isLate)
                            {
                                <div><span class="badge bg-danger text-white"><i class="bi bi-alarm"></i> Trễ hạn</span></div>
                            }
                        </td>
                        <td><money value="@r.Deposit" /></td>
                        <td class="fw-semibold text-primary"><money value="@r.TotalPrice" /></td>
                        <td><status-badge status="@r.Status" /></td>
                        <td class="text-end text-nowrap">
                            @if (r.Status == "Active")
                            {
                                <button type="button" class="btn btn-sm btn-success btn-return"
                                        data-bs-toggle="modal" data-bs-target="#returnModal"
                                        data-id="@r.RentalId"
                                        data-customer="@r.CustomerName"
                                        data-bike="@r.MotorbikeName (@r.LicensePlate)"
                                        data-deposit="@r.Deposit"
                                        data-price="@r.PricePerDay"
                                        data-total="@r.TotalPrice"
                                        data-islate="@(isLate ? "true" : "false")">
                                    <i class="bi bi-check-lg"></i> Trả xe
                                </button>
                                <form asp-action="Cancel" asp-route-id="@r.RentalId" method="post" class="d-inline" 
                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy phiếu thuê #@r.RentalId?');">
                                    <button class="btn btn-sm btn-outline-danger" title="Hủy phiếu">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-action="Print" asp-route-id="@r.RentalId" target="_blank" class="btn btn-sm btn-outline-secondary" title="In phiếu">
                                    <i class="bi bi-printer"></i> In
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i> Không có dữ liệu phiếu thuê nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL TRẢ XE & QUYẾT TOÁN CỌC -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Return" method="post" class="modal-content shadow">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalRentalId" name="id" />

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-check2-circle"></i> Trả xe & Quyết toán chi phí</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="p-2 mb-3 bg-light rounded border">
                    <div>Khách hàng: <strong id="lblCustomer" class="text-dark"></strong></div>
                    <div>Xe: <strong id="lblBike" class="text-dark"></strong></div>
                    <div>Tiền cọc ban đầu: <span id="lblDeposit" class="badge bg-primary fs-6">0 ₫</span></div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Phí trễ hạn</label>
                        <input type="number" id="inpLateFee" name="LateFee" class="form-control calc-trigger" value="0" min="0" step="10000" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Phí hỏng hóc/trầy xước</label>
                        <input type="number" id="inpDamageFee" name="DamageFee" class="form-control calc-trigger" value="0" min="0" step="10000" />
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Phụ thu khác (xăng, nón)</label>
                        <input type="number" id="inpOtherFee" name="OtherFee" class="form-control calc-trigger" value="0" min="0" step="10000" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Số Km (Odo) lúc trả</label>
                        <input type="number" name="OdometerIn" class="form-control" placeholder="Km trên đồng hồ" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Hiện trạng & Ghi chú nhận xe</label>
                    <textarea name="ConditionNote" class="form-control" rows="2" placeholder="Ví dụ: Xe đủ 2 nón, không trầy xước, xăng đầy"></textarea>
                </div>

                <!-- Bảng tính toán tiền cọc tức thì -->
                <div class="card bg-body-tertiary border-0 p-3">
                    <div class="d-flex justify-content-between mb-1 small">
                        <span>Tiền thuê xe:</span>
                        <strong id="lblBaseRent">0 ₫</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small text-danger">
                        <span>Tổng phụ phí:</span>
                        <strong id="lblExtraTotal">0 ₫</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small text-muted border-bottom pb-1">
                        <span>Trừ tiền cọc đã giữ:</span>
                        <strong id="lblDepositSub">- 0 ₫</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-1">
                        <span class="fw-bold" id="lblResultTitle">Khách cần thanh toán:</span>
                        <span class="fs-5 fw-bold" id="lblResultAmount">0 ₫</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Xác nhận hoàn tất</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let baseRent = 0;
            let deposit = 0;

            const modal = document.getElementById('returnModal');
            modal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const customer = button.getAttribute('data-customer');
                const bike = button.getAttribute('data-bike');
                deposit = parseFloat(button.getAttribute('data-deposit')) || 0;
                baseRent = parseFloat(button.getAttribute('data-total')) || 0;

                document.getElementById('modalRentalId').value = id;
                document.getElementById('lblCustomer').textContent = customer;
                document.getElementById('lblBike').textContent = bike;
                document.getElementById('lblDeposit').textContent = deposit.toLocaleString('vi-VN') + ' ₫';
                document.getElementById('lblDepositSub').textContent = '- ' + deposit.toLocaleString('vi-VN') + ' ₫';
                document.getElementById('lblBaseRent').textContent = baseRent.toLocaleString('vi-VN') + ' ₫';

                // Reset các ô phụ phí
                document.getElementById('inpLateFee').value = 0;
                document.getElementById('inpDamageFee').value = 0;
                document.getElementById('inpOtherFee').value = 0;

                recalc();
            });

            function recalc() {
                const late = parseFloat(document.getElementById('inpLateFee').value) || 0;
                const damage = parseFloat(document.getElementById('inpDamageFee').value) || 0;
                const other = parseFloat(document.getElementById('inpOtherFee').value) || 0;

                const totalExtra = late + damage + other;
                const grandTotal = baseRent + totalExtra;
                const balance = grandTotal - deposit;

                document.getElementById('lblExtraTotal').textContent = totalExtra.toLocaleString('vi-VN') + ' ₫';

                const titleEl = document.getElementById('lblResultTitle');
                const amountEl = document.getElementById('lblResultAmount');

                if (balance > 0) {
                    titleEl.textContent = 'Khách cần thanh toán thêm:';
                    titleEl.className = 'fw-bold text-danger';
                    amountEl.textContent = balance.toLocaleString('vi-VN') + ' ₫';
                    amountEl.className = 'fs-5 fw-bold text-danger';
                } else if (balance < 0) {
                    titleEl.textContent = 'Cửa hàng hoàn trả lại cọc:';
                    titleEl.className = 'fw-bold text-success';
                    amountEl.textContent = Math.abs(balance).toLocaleString('vi-VN') + ' ₫';
                    amountEl.className = 'fs-5 fw-bold text-success';
                } else {
                    titleEl.textContent = 'Tiền cọc vừa đủ:';
                    titleEl.className = 'fw-bold text-primary';
                    amountEl.textContent = '0 ₫';
                    amountEl.className = 'fs-5 fw-bold text-primary';
                }
            }

            document.querySelectorAll('.calc-trigger').forEach(input => {
                input.addEventListener('input', recalc);
            });
        });
    </script>
}