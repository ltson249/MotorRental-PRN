@model CustomerVm
<div class="card shadow-sm" style="max-width:640px">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <form asp-action="@(Model.CustomerId == 0 ? "Create" : "Edit")" asp-route-id="@(Model.CustomerId == 0 ? null : Model.CustomerId.ToString())" method="post">
            <input type="hidden" asp-for="CustomerId" />
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="IdentityNumber" class="form-label"></label>
                    <input asp-for="IdentityNumber" class="form-control" />
                    <span asp-validation-for="IdentityNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="DriverLicense" class="form-label"></label>
                <input asp-for="DriverLicense" class="form-control" />
                <span asp-validation-for="DriverLicense" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <button class="btn btn-primary">Lưu</button>
            <a class="btn btn-secondary" asp-action="Index">Hủy</a>
        </form>
    </div>
</div>
