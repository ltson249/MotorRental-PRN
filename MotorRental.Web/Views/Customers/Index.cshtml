@model List<CustomerVm>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-people text-primary me-2"></i>Hồ Sơ Khách Hàng</h2>
        <p class="text-muted mb-0 small">Quản lý định danh khách thuê xe, số CCCD/Hộ chiếu, GPLX và địa chỉ lưu trú</p>
    </div>
    <a class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" asp-action="Create">
        <i class="bi bi-person-plus"></i> + Đăng ký khách hàng mới
    </a>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card card-custom mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input name="q" value="@ViewBag.Q" class="form-control border-start-0" placeholder="Tìm theo họ tên, số điện thoại, số CCCD/CMND..." />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary px-4">Tìm kiếm</button>
        </div>
    </form>
</div>

<!-- Bảng khách hàng -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>CCCD / Hộ chiếu</th>
                    <th>Giấy phép lái xe</th>
                    <th>Địa chỉ / Nơi cư trú</th>
                    <th class="text-end" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">@c.CustomerId</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 0.9rem;">
                                    @(string.IsNullOrWhiteSpace(c.FullName) ? "K" : c.FullName.Trim().Substring(0, 1).ToUpper())
                                </div>
                                <div class="fw-semibold text-dark">@c.FullName</div>
                            </div>
                        </td>
                        <td>
                            <a href="tel:@c.Phone" class="text-decoration-none fw-medium text-primary">
                                <i class="bi bi-telephone me-1"></i>@c.Phone
                            </a>
                        </td>
                        <td><span class="badge bg-light text-dark border font-monospace fs-6">@c.IdentityNumber</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(c.DriverLicense))
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-card-checklist me-1"></i>@c.DriverLicense
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">Chưa cập nhật</span>
                            }
                        </td>
                        <td class="text-truncate" style="max-width: 220px;" title="@c.Address">
                            @(string.IsNullOrWhiteSpace(c.Address) ? "---" : c.Address)
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@c.CustomerId" title="Sửa thông tin khách">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng @c.FullName?');">
                                <button class="btn btn-sm btn-outline-danger" title="Xóa hồ sơ">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            Không tìm thấy hồ sơ khách hàng nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
