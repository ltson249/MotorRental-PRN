@model List<CustomerVm>
@{ ViewData["Title"] = "Khách hàng"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Khách hàng</h3>
    <a class="btn btn-primary" asp-action="Create">+ Thêm khách hàng</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm theo tên, SĐT, CCCD..." /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Tìm</button></div>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Họ tên</th><th>SĐT</th><th>CCCD/CMND</th><th>GPLX</th><th>Địa chỉ</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.FullName</td>
                        <td>@c.Phone</td>
                        <td>@c.IdentityNumber</td>
                        <td>@c.DriverLicense</td>
                        <td>@c.Address</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.CustomerId">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Xóa khách hàng này?');">
                                <button class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted">Không có dữ liệu</td></tr> }
            </tbody>
        </table>
    </div>
</div>
